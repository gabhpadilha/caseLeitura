# Copie para .env.local e preencha com os dados do projeto
# (Supabase Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Login com Google: só ligue depois de configurar o provedor no Supabase
# (Authentication → Providers → Google). Sem isso o botão daria erro.
# NEXT_PUBLIC_AUTH_GOOGLE=on
